{
  "id": "prayer-of-azariah",
  "title": {
    "en": "Prayer of Azariah and Song of the Three Holy Children",
    "zh-Hant": "三童歌"
  },
  "language": "zh-Hant",
  "source": {
    "url": "https://bible.fhl.net/new/readsub.php?chineses=%E7%AB%A5&chap=1&VERSION1=c1933&TABFLAG=0",
    "credit": "《次經》，中華聖公會書籍委員會，1933；信望愛數位文本。",
